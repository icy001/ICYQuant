# ICYQuant Configuration
# Copy this file to .env and modify as needed

APP_NAME=ICYQuant
APP_VERSION=0.4.0-alpha2
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_FILE=icyquant.log

# Database (PostgreSQL)
DATABASE_URL=postgresql://icyquant:password@localhost:5432/icyquant
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=50
REDIS_TIMEOUT=5

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=icyquant-consumer
KAFKA_AUTO_OFFSET_RESET=earliest

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Broker Configuration
BROKER_NAME=simulated
# BROKER_API_KEY=your-api-key
# BROKER_API_SECRET=your-api-secret
# BROKER_BASE_URL=https://api.broker.com

# Security
SECRET_KEY=change-me-in-production-please
SECRET_ROTATION_DAYS=90

# Observability
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=true
TRACING_EXPORTER_OTLP_ENDPOINT=http://localhost:4317