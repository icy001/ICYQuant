# Runtime server logs
*.log

# Python package build metadata
*.egg-info/


# IDE project data
.codebuddy/

# Research synthetic OHLCV datasets (regenerable via
# `python infra/scripts/generate_research_dataset.py`); manifests stay tracked
data/processed/*.csv
data/raw/

# Validation-phase paper snapshots: runtime data assets, NOT code.
# Git keeps code/spec/gates/templates + the manifest convention; the
# per-day replay artifacts under factor-paper-snapshots/YYYY-MM-DD/ are
# diffed against the baseline outside version control.
research/discovery/output/factor-paper-snapshots/

# Trading-UI runtime config (paper account + risk rules) - defaults are
# seeded in code; saved values are runtime state, not source.
data/config/

# Alert disposition ledger (Phase 1 persistence) - runtime state, not source.
data/alerts/

# LEAN paper bridge (P0-01): strategy_contract.json is rewritten on every
# `python -m apps.runtime lean-paper` run, so it is runtime state, not source.
# The contract *schema* lives in apps/adapters/lean/contract.py and the
# human-readable sample is embedded in the tracked gate report under
# artifacts/lean_paper_e2e/ - both stay in version control.
integrations/lean/paper/strategy_contract.json
artifacts/lean_paper_e2e/strategy_contract.json

# LEAN live deployment output (`lean live deploy --output`): securities,
# portfolio and price-data dumps written by the LEAN engine on every paper
# run. Regenerable and potentially large; the graded summary that matters is
# the tracked e2e_report.* sitting next to it.
artifacts/lean_paper_e2e/live-results/